# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/cinelens?retryWrites=true&w=majority

# Sanity (optional - for CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Resend (optional - for email notifications)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=CineLensStudios <hello@yourdomain.com>

# Cloudinary (for portfolio images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=cinelens

# Admin (credentials & JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
ADMIN_SECRET=your_random_secret_for_jwt_signing

# NextAuth (optional)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_secret_here
